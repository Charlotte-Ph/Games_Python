import random
import random

words = ["python", "java", "javascript", "hangman", "developer", "algorithm", "computer", "function", "loop", "variable"]

def choose_word(difficulty):
    if difficulty == 'easy':
        return random.choice([word for word in words if len(word) <= 5])
    elif difficulty == 'medium':
        return random.choice([word for word in words if 5 < len(word) <= 8])
    else:
        return random.choice([word for word in words if len(word) > 8])

def display_word(word, guessed_letters):
    return " ".join([letter if letter in guessed_letters else "_" for letter in word])

def display_hangman(attempts):
    stages = [
        '''
           ------
           |    |
                |
                |
                |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
                |
                |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
           |    |
                |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
          /|    |
                |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
          /|\\   |
                |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
          /|\\   |
          /     |
                |
        -----------
        ''',
        '''
           ------
           |    |
           O    |
          /|\\   |
          / \\   |
                |
        -----------
        '''
    ]
    return stages[6 - attempts]

def hangman():
    print("Welcome to Hangman!")
    difficulty = input("Choose difficulty (easy, medium, hard): ").lower()
    word = choose_word(difficulty)
    guessed_letters = []
    attempts = 6
    correct_guesses = 0
    word_length = len(word)
    guessed_word = display_word(word, guessed_letters)

    while attempts > 0 and correct_guesses < word_length:
        print("\nWord: ", guessed_word)
        print(f"Attempts remaining: {attempts}")
        print(display_hangman(attempts))
        
        guess = input("Guess a letter: ").lower()

        if len(guess) != 1 or not guess.isalpha():
            print("Please enter a single valid letter.")
            continue

        if guess in guessed_letters:
            print(f"You've already guessed '{guess}'. Try another letter.")
            continue

        guessed_letters.append(guess)

        if guess in word:
            correct_guesses += word.count(guess)
            print(f"Good job! '{guess}' is in the word.")
        else:
            attempts -= 1
            print(f"Sorry, '{guess}' is not in the word.")

        guessed_word = display_word(word, guessed_letters)

    if correct_guesses == word_length:
        print("\nCongratulations! You guessed the word:", word)
    else:
        print(f"\nGame Over! The word was: {word}")

    play_again = input("Do you want to play again? (yes/no): ").lower()
    if play_again == 'yes':
        hangman()

hangman()
