import random

def guess_number():
    # Generate a random number between 1 and 100
    number = random.randint(1, 100)
    
    # Set the initial number of guesses
    guesses_taken = 0
    
    print("Welcome to the Guessing Game!")
    print("I'm thinking of a number between 1 and 100.")
    
    while True:
        # Prompt the user to make a guess with input validation
        try:
            guess = int(input("Take a guess: "))
        except ValueError:
            print("Please enter a valid number.")
            continue
        
        # Increment the number of guesses
        guesses_taken += 1
        
        # Provide feedback on the guess
        if guess < number:
            print("Too low!")
        elif guess > number:
            print("Too high!")
        else:
            print(f"Good job! You guessed the number in {guesses_taken} tries.")
            break

    # Ask the user if they want to play again
    play_again = input("Do you want to play again? (yes/no): ").lower()
    if play_again == "yes":
        guess_number()  # Restart the game if they want to play again
    else:
        print("Thanks for playing!")

guess_number()
